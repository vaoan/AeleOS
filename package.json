{
  "name": "aeleos",
  "version": "0.1.0",
  "private": true,
  "description": "AeleOS — central identity for the Furry Colombia platform.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter hub dev",
    "build": "pnpm --filter hub build",
    "test:hub": "pnpm --filter hub test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase db reset && vitest run -c vitest.config.integration.ts",
    "test:idp": "vitest run -c vitest.config.idp.ts",
    "test:idp:cloud": "node scripts/run-cloud-idp.mjs",
    "capture:token": "npx --yes serve scripts -l 5555",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "lint:fix": "eslint . --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,yml,yaml}\"",
    "fix:staged": "lint-staged --concurrent false",
    "fix:all": "pnpm format && pnpm lint:fix",
    "typecheck": "tsc --noEmit && pnpm --filter hub typecheck && pnpm --filter @aeleos/identity typecheck",
    "check:tools": "pnpm test:tools && pnpm check:contrast && cspell \"**/*.{ts,tsx,md,json}\" --no-progress && ls-lint && knip --no-exit-code && jscpd . && (madge --circular --extensions ts,tsx,mjs tests scripts apps/hub/src || true)",
    "secretlint": "secretlint \"**/*\"",
    "sync-secrets": "node scripts/sync-secrets.mjs",
    "prepare": "husky",
    "test:hub:coverage": "pnpm --filter hub test:coverage",
    "check:docs": "node scripts/check-doc-freshness.mjs",
    "test:tools": "vitest run -c vitest.config.tools.ts",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@cspell/dict-es-es": "^3.0.8",
    "@eslint/js": "^9.39.4",
    "@ls-lint/ls-lint": "^2.3.1",
    "@secretlint/secretlint-rule-preset-recommend": "^12.3.1",
    "@supabase/supabase-js": "^2.110.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "cspell": "^10.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jose": "^6.0.11",
    "jscpd": "^4.0.9",
    "knip": "^6.7.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "pg": "^8.13.1",
    "prettier": "^3.8.3",
    "secretlint": "^12.3.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "supabase": "^2.95.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --check",
      "eslint --max-warnings=0 --no-warn-ignored",
      "secretlint --no-glob"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --check"
    ]
  }
}
