{
  "version": "0.2",
  "language": "en,en-GB",
  "allowCompoundWords": true,
  "ignorePaths": [
    "node_modules/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock",
    "**/generated/**",
    // Playwright's artefacts. They are gitignored but cspell walks the working
    // tree, not the index — so a single failed run locally left `check:tools`
    // failing on the Spanish words in a captured page, which is a check
    // failing for a reason nobody can act on and the fastest way to teach
    // somebody to stop reading it.
    "**/test-results/**",
    "**/playwright-report/**",
    "supabase/migrations/**",
    "supabase/config.toml",
    ".superpowers/**"
  ],
  "words": [
    // The Portuguese national web archive, which holds captures
    // `web.archive.org` does not — see the pastiche findings.
    "arquivo",
    // The longest option in the leaf's kind select, quoted where the 320px
    // overflow it caused is recorded. Named rather than paraphrased, because
    // "its longest option" is not something a reader can check.
    "Reproductor",
    "música",
    "vibro",
    // The era looks' own ids. They are identifiers rather than prose — the
    // pages are named `era-winxp` and so on — and no dictionary has them.
    "winxp",
    "win98",
    // The pastiche pages name the sites they imitate; these are the ones no
    // dictionary has. `README.md` and `scripts/seed-pastiches.mjs` are the only
    // files that use them.
    "Fotolog",
    "Metroflog",
    // The MySpace profile whose October 2008 capture is the reference for that
    // pastiche. A real username, quoted so the capture can be found again —
    // "a real profile" is not something a reader can check.
    "akioyang",
    // Sonico's own handle-leaf title, quoted verbatim in the pastiche
    // findings' account of how that title has no shared convention across
    // the sixteen seeded pages.
    "Usuario",
    // arquivo.pt's own missing-page placeholder, quoted verbatim because it
    // appears INSIDE some captures and a reader meeting it in a screenshot
    // should be able to grep for what it is.
    "conseguimos",
    "encontrar",
    "página",
    // The Spanish half of the inspiration section's name, and of the line a
    // page shows where no capture of it can exist. These are the seeded page's
    // own writing rather than catalogue keys — a person's own words are never
    // next-intl — so the strings are named in the plan and the seeder.
    "inspiración",
    "existe",
    "captura",
    // The Spanish quoted in rule 42, which records that `check:tools`'s
    // cspell glob never opens the .mjs file those strings live in. The rule
    // quotes the sentence it is about and the RAE example that made the form
    // arguable, so the words must be spellable here even though the file they
    // came from is checked by nothing.
    "fueron",
    "páginas",
    "única",
    "alegría",
    "visitas",
    "picsum",
    "pixabay",
    "showcase",
    "Cascadia",
    // Impact's metric-compatible fallback on Windows, named in the poster font
    // stack. A real face, not a coinage.
    "Haettenschweiler",
    "Consolas",
    "Segoe",
    "Tahoma",
    "sprited",
    // The verb for what the block model did to `gallery` and `links`, and what
    // the identity header gets next. "welded" and "unwelded" are already this
    // repo's idiom and both are real words; only the bare verb is coined.
    "unweld",
