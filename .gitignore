# Secrets — never commit real values
.env
.env.*
!.env.example
.secrets
*.local

# Transient working files of scripts/sync-secrets.mjs. Both are removed on the
# happy path, but a crash mid-sync leaves plaintext secrets on disk — `.secrets`
# above is an exact match and does not cover them.
.secrets-download/
.secrets-decrypted.tmp

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# IdP config exports may contain secrets — keep raw dumps out; commit sanitized only
clerk-export.raw.json
logto-export.raw.json

# Local Supabase test bed
supabase/.temp/
supabase/.branches/
