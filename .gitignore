# Secrets — never commit real values
.env
.env.*
!.env.example
.secrets
*.local

# Transient working files of scripts/sync-secrets.mjs. Both are removed on the
# happy path, but a crash mid-sync leaves plaintext secrets on disk — `.secrets`
# above is an exact match and does not cover them.
.secrets-download/
.secrets-decrypted.tmp

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code — `.claude/settings.json` is shared and committed; everything
# below it is per-machine. `*.local` above does not match `settings.local.json`,
# which is how that file was once swept into an unrelated commit in puck.
.claude/settings.local.json
.claude/history.jsonl
.claude/auth.json
.claude/models_cache.json
.claude/version.json
.claude/scheduled_tasks.lock

# IdP config exports may contain secrets — keep raw dumps out; commit sanitized only
clerk-export.raw.json
logto-export.raw.json

# Local Supabase test bed
supabase/.temp/
supabase/.branches/

# Next.js
apps/hub/.next/
apps/hub/next-env.d.ts
apps/hub/playwright-report/
apps/hub/test-results/

# Vercel CLI scratch. `vercel pull` writes the project link and the pulled
# environment here — the environment file holds real secret values, and the
# link is redundant because CI passes VERCEL_ORG_ID/VERCEL_PROJECT_ID instead.
.vercel/

# tsc --incremental cache (apps/hub/tsconfig.json sets "incremental": true)
apps/hub/tsconfig.tsbuildinfo
# `tsc -b` at the root writes one here too, and it was not ignored.
tsconfig.tsbuildinfo

# Superpowers brainstorming companion scratch (mockups, session state)
.superpowers/
