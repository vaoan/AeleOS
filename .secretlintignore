# The local secret store. It is gitignored (.gitignore:5) and exists to hold
# real values, so scanning it is a guaranteed false positive — it went red the
# moment a Vercel token was added, which would train us to ignore this gate.
# Committing is prevented by .gitignore, not by this scan. Everything else,
# including .secrets.example, is still scanned.
.secrets

node_modules/**
**/.git/**
**/.pnpm/**
**/.next/**
**/coverage/**
.superpowers/**
supabase/.temp/**
supabase/.branches/**
pnpm-lock.yaml
