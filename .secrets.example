# Copy to .secrets and fill in from the Clerk dashboard.
# .secrets is gitignored — never commit real values.
#
# Once the three Clerk values are stored as GitHub repository secrets,
# `pnpm sync-secrets` regenerates .secrets for you instead. It overwrites the
# file wholesale, so sync first and capture the session token afterwards.

# Clerk Dashboard > API Keys > Publishable key (starts pk_test_ on a dev instance)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Dashboard > API Keys > Secret key (starts sk_test_ on a dev instance)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Revealed when you activate the Supabase integration.
# Looks like: your-app-name.clerk.accounts.dev
CLERK_DOMAIN=example.clerk.accounts.dev

# Populated later, by the capture page. A real session JWT, valid about 60
# seconds. Never synced from GitHub — a synced copy would arrive expired.
CLERK_SESSION_TOKEN=

# Cloudflare API token for the furrycolombia.com zone. Writes the Clerk and
# Vercel DNS records during deployment — see
# docs/superpowers/plans/2026-08-11-hub-deployment.md.
#
# Scoped to that one zone (verified: it sees no other). Its reach is wider than
# DNS — Workers routes and page rules are also editable — so treat it as a zone
# token rather than a DNS-only one. Zone settings, firewall rules and SSL certs
# were denied. Synced from GitHub, so `pnpm sync-secrets` restores it.
CF_API_TOKEN=
