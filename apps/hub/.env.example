# Copy to .env.local and fill in. .env.local is gitignored.
#
# The defaults below point at the CLOUD services, so a fresh clone runs on any
# machine with no Docker and no local Supabase stack:
#
#   pnpm install && pnpm sync-secrets && cp apps/hub/.env.example apps/hub/.env.local
#
# then paste the four values from .secrets. This is the normal path.

# Clerk — from ../../.secrets after `pnpm sync-secrets`, or Dashboard > API Keys.
# Development keys are pk_test_/sk_test_. Production is pk_live_/sk_live_ and
# belongs only in Vercel, never here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret. Never prefix this NEXT_PUBLIC_ — that prefix ships a value in the
# browser bundle.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — the hosted AeleOS project. Use SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY from .secrets verbatim.
#
# This is the same database the deployed site uses. Signing in while developing
# provisions a real actor in the shared registry — which is what makes `pnpm dev`
# work anywhere, and is why it is not isolated. Fine while the registry holds
# only test actors; revisit once real people have signed up.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-SUPABASE_PUBLISHABLE_KEY-from-.secrets

# --- Working against a local stack instead (optional) ---
#
# Only needed to develop schema changes against a throwaway database. Requires
# Docker, `pnpm exec supabase start`, and enabling the Clerk provider in
# supabase/config.toml — see docs/phase-0-clerk-setup.md §5. Swap the two
# Supabase values for the output of `pnpm exec supabase status`:
#
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase status>
#
# `pnpm test:db` always uses the local stack and is unaffected by this file.

# Comma-separated origins the picker may redirect back to.
# Exact origin match — scheme, host and port together. No wildcards, no
# subdomain matching. Optional: unset or empty means the picker refuses every
# return_to, and the rest of the app boots normally.
# Each entry is normalised to its parsed origin, so a trailing slash, a pasted
# callback path or capitals all still match what they obviously mean.
AELEOS_ALLOWED_RETURN_ORIGINS=http://localhost:5000

# This deployment's own hostname, with no scheme. Twitch's player refuses to
# load unless `parent=` names the embedding domain — this is the one provider
# that needs to know where it is. Optional: unset means Twitch resolves to
# nothing and renders as a link, which is the correct outcome on a preview
# deployment where no fixed value could be right.
NEXT_PUBLIC_HUB_HOST=localhost
